# Convenience reference for local development.
# The app reads environment from:
# - apps/api/.env
# - apps/web/.env.local

# Shared local URLs
WEB_APP_BASE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Clerk
CLERK_JWKS_URL=https://your-clerk-domain/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-domain
CLERK_AUDIENCE=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_TEMPLATE=

# Postgres
DATABASE_URL=postgresql://choir:choir@127.0.0.1:5432/choir

# Resend
COMMUNICATIONS_EMAIL_PROVIDER=resend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Choir App <noreply@example.com>

# Google Calendar OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/google-calendar/oauth/callback
GOOGLE_OAUTH_SCOPES=openid,email,https://www.googleapis.com/auth/calendar
GOOGLE_TOKEN_ENCRYPTION_KEY=

